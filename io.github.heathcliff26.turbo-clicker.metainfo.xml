  <name>Turbo Clicker</name>
  <summary>Graphical auto-clicker app</summary>
  <metadata_license>MIT</metadata_license>
  <project_license>Apache-2.0</project_license>
  <description>
    <p>
            Turbo Clicker is a GUI based auto-clicker for Linux (Wayland). It simulates virtual input via x11/wayland-client.
        </p>
    <p>
            The user needs to accept remote access permissions for the app.
        </p>
  </description>
